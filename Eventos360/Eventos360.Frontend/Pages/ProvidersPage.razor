@page "/provider"
@inherits LayoutComponentBase

<div class="container my-3">

    <!-- HERO / STAND -->
    <div class="row">
        <div class="col-12 position-relative">
            <img src="@selectedProveedor.ImagenBannerUrl"
                 class="img-fluid w-100 rounded-4 shadow rounded-3"
                 style="max-height:420px; object-fit:cover"
                 alt="@selectedProveedor.Nombre" />

            <div class="position-absolute bottom-0 start-0 m-3 p-3 bg-dark bg-opacity-75 rounded-3">
                <h1 class="text-white fw-bold mb-1">@selectedProveedor.Nombre</h1>
                <p class="text-light mb-1">@selectedProveedor.Categoria.Nombre</p>
                <span class="badge bg-warning text-dark">
                    @selectedProveedor.Stand
                </span>
            </div>
        </div>
    </div>

    <div class="row mt-4">

        <!-- COLUMNA IZQUIERDA -->
        <div class="col-lg-4">

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="mt-3 text-center">

                        <div class="d-flex justify-content-center gap-3">
                            <a href="@selectedProveedor.WhatsApp"
                               class="btn btn-success w-100 mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg> 
                                WhatsApp
                            </a>

                            <a href="@selectedProveedor.UrlSitioWeb"
                               target="_blank"
                               class="btn btn-outline-primary w-100 mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-world-pin"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M20.972 11.291a9 9 0 1 0 -8.322 9.686" /><path d="M3.6 9h16.8" /><path d="M3.6 15h8.9" /><path d="M11.5 3a17 17 0 0 0 0 18" /><path d="M12.5 3a16.986 16.986 0 0 1 2.578 9.018" /><path d="M21.121 20.121a3 3 0 1 0 -4.242 0c.418 .419 1.125 1.045 2.121 1.879c1.051 -.89 1.759 -1.516 2.121 -1.879" /><path d="M19 18v.01" /></svg> 
                                Sitio web
                            </a>
                        </div>
                    </div>
                    

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <strong>Ubicación:</strong><br />
                            @selectedProveedor.Ciudad, @selectedProveedor.Estado
                        </li>

                        <li class="list-group-item">
                            <strong>Precio:</strong><br />
                            @selectedProveedor.PrecioMinimo?.ToString("C0")
                            -
                            @selectedProveedor.PrecioMaximo?.ToString("C0")
                        </li>

                        <li class="list-group-item">
                            <strong>Servicios:</strong><br />
                            @string.Join(", ", selectedProveedor.TagsProvedors.Select(t => t.Tag.Nombre))
                        </li>

                    </ul>
                    <strong>Horarios</strong>
                    <ul class="list-group list-group-flush">
                        @foreach (var horario in selectedProveedor.Horarios)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">

                                <strong>@horario.DiaSemana</strong>

                                <div class="text-muted text-end">
                                    @DateTime.Today.Add(horario.HoraApertura).ToString("hh:mm tt")
                                    -
                                    @DateTime.Today.Add(horario.HoraCierre).ToString("hh:mm tt")
                                </div>

                            </li>
                        }
                    </ul>


                    <strong>Redes Sociales</strong>
                    <div class="mt-3 text-center">

                        <div class="d-flex justify-content-center gap-3">

                            @* Facebook *@
                            @if (!string.IsNullOrWhiteSpace(selectedProveedor.RedesSociales?.Facebook))
                            {
                                <a href="@selectedProveedor.RedesSociales.Facebook"
                                   target="_blank"
                                   class="text-secondary"
                                   aria-label="Facebook">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" /></svg>
                                </a>
                            }

                            @* Instagram *@
                            @if (!string.IsNullOrWhiteSpace(selectedProveedor.RedesSociales?.Instagram))
                            {
                                <a href="@selectedProveedor.RedesSociales.Instagram"
                                   target="_blank"
                                   class="text-secondary"
                                   aria-label="Instagram">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8" /><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /><path d="M16.5 7.5v.01" /></svg>
                                </a>
                            }

                            @* Twitter *@
                            @if (!string.IsNullOrWhiteSpace(selectedProveedor.RedesSociales?.Twitter))
                            {
                                <a href="@selectedProveedor.RedesSociales.Twitter"
                                   target="_blank"
                                   class="text-secondary"
                                   aria-label="Twitter">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-x"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 4l11.733 16h4.267l-11.733 -16l-4.267 0" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" /></svg>
                                </a>
                            }

                            @* YouTube *@
                            @if (!string.IsNullOrWhiteSpace(selectedProveedor.RedesSociales?.YouTube))
                            {
                                <a href="@selectedProveedor.RedesSociales.YouTube"
                                   target="_blank"
                                   class="text-secondary"
                                   aria-label="YouTube">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-youtube"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8" /><path d="M10 9l5 3l-5 3l0 -6" /></svg>
                                </a>
                            }

                        </div>
                    </div>


                </div>
            </div>

        </div>

        <!-- COLUMNA DERECHA -->
        <div class="col-lg-8">

            <h3 class="fw-bold mb-2">Descripción</h3>
            <p class="text-muted">@selectedProveedor.Descripcion</p>

            <hr />

            <!-- GALERÍA -->
            @if (selectedProveedor.Galeria.Any())
            {
                <div class="row g-2">
                    @foreach (var img in selectedProveedor.Galeria)
                    {
                        <div class="col-6 col-md-4">
                            <img src="@img.Url"
                                 class="img-fluid rounded shadow-sm"
                                 alt="Galería proveedor" />
                        </div>
                    }
                </div>
            }

        </div>

    </div>

    <!-- PRODUCTOS DESTACADOS -->
    @if (selectedProveedor.Productos.Any(p => p.Destacado))
    {
        <div class="mt-5">
            <h3 class="fw-bold mb-3">Servicios Destacados</h3>

            <div class="row g-4">
                @foreach (var item in selectedProveedor.Productos.Where(p => p.Destacado))
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm">
                            <img src="@item.ImagenUrl"
                                 class="card-img-top"
                                 alt="@item.Nombre" />
                            <div class="card-body">
                                <h5 class="card-title">@item.Nombre</h5>
                                <p class="card-text">@item.Descripcion</p>
                                <span class="fw-bold">@item.Precio.ToString("C0")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    @if (selectedProveedor.Reseñas.Any())
    {
        <div class="mt-5">

            <!-- HEADER -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="fw-bold mb-0">Reseñas</h3>

                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 fw-bold">@PromedioCalificacion</span>
                    <div>
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(PromedioCalificacion))
                            {
                                <span class="text-warning fs-5">★</span>
                            }
                            else
                            {
                                <span class="text-secondary fs-5">★</span>
                            }
                        }
                    </div>
                    <span class="text-muted">
                        (@selectedProveedor.Reseñas.Count)
                    </span>
                </div>
            </div>

            <!-- LISTADO DE RESEÑAS -->
            <div class="row g-3">

                @foreach (var reseña in selectedProveedor.Reseñas.OrderByDescending(r => r.FechaCreacion))
                {
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-body">

                                <!-- ESTRELLAS -->
                                <div class="mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= reseña.Calificacion)
                                        {
                                            <span class="text-warning">★</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">★</span>
                                        }
                                    }
                                </div>

                                <!-- COMENTARIO -->
                                <p class="mb-2 text-muted">
                                    “@reseña.Comentario”
                                </p>

                                <!-- FECHA -->
                                <small class="text-secondary">
                                    @reseña.FechaCreacion.ToString("dd MMM yyyy")
                                </small>

                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    }
    else
    {
        <!-- Estado vacío -->
        <div class="mt-5 text-center text-muted">
            <p class="mb-1">Este proveedor aún no tiene reseñas.</p>
            <small>Sé el primero en calificar su servicio.</small>
        </div>
    }


</div>
