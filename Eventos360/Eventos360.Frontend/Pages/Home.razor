<!--Home-->
@page "/"
@using Eventos360.Frontend.Data

<PageTitle>Home</PageTitle>
<BannerComponent/>
<FullWidthCarouselComponent/>
<!--
    <CategoryComponent/>
-->
<h1 style="font-size:32px; font-weight:700; margin-top:20px;">
    Nuestros mejores Proveedores
</h1>

@foreach (var categoria in CategoriasData.Todas)
{
    var topProveedores = ProveedoresData.TopPorCategoria(categoria.Id);

    if (topProveedores.Any())
    {
        <ProveedoresComponent CategoriaNombre="@categoria.Nombre"
                              CategoriaDescripcion="@categoria.Descripcion"
                              CategoriaImagenUrl="@categoria.ImagenUrl"
                              Proveedores="topProveedores" />
    }
}
<ContactFormComponent />
<ProveedoresTagsComponent/>
