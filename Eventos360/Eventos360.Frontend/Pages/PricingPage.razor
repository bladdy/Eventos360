@page "/precios"

<PageTitle>Planes y Precios</PageTitle>

<div style="width:100%; padding:60px 20px; box-sizing:border-box;">

    <!-- Título -->
    <div style="text-align:center; margin-bottom:50px;">
        <h1 style="font-size:36px; font-weight:800; margin-bottom:10px;">
            Planes y precios
        </h1>
        <p style="font-size:18px; color:#666;">
            Elige el plan que mejor se adapte a tu negocio
        </p>
    </div>

    <!-- Cards -->
    <div style="
        display:flex;
        gap:30px;
        justify-content:center;
        align-items:stretch;
        flex-wrap:wrap;
margin-bottom:50px;
    ">

        <!-- Básico -->
        <div style="
            width:320px;
            border-radius:22px;
            padding:30px;
            background:#ffffff;
            box-shadow:0 10px 25px rgba(0,0,0,0.08);
            text-align:center;
        ">
            <h3 style="font-size:24px; font-weight:800;">Básico</h3>
            <p style="font-size:32px; font-weight:900; margin:20px 0;">
                $0
            </p>
            <p style="color:#666; margin-bottom:20px;">
                Ideal para empezar
            </p>

            <ul style="list-style:none; padding:0; margin:0 0 25px 0;">
                <li>✔ Perfil básico</li>
                <li>✔ Visibilidad limitada</li>
                <li>✔ Contacto por formulario</li>
            </ul>

            <button class="btn btn-outline-primary w-100">
                Empezar
            </button>
        </div>

        <!-- Intermedio -->
        <div style="
            width:320px;
            border-radius:22px;
            padding:35px 30px;
            background:#0d6efd;
            color:white;
            box-shadow:0 15px 30px rgba(13,110,253,0.4);
            text-align:center;
            transform:scale(1.05);
        ">
            <h3 style="font-size:24px; font-weight:800;">Intermedio</h3>
            <p style="font-size:32px; font-weight:900; margin:20px 0;">
                $499 / mes
            </p>
            <p style="opacity:0.9; margin-bottom:20px;">
                El más elegido
            </p>

            <ul style="list-style:none; padding:0; margin:0 0 25px 0;">
                <li>✔ Perfil destacado</li>
                <li>✔ Galería de imágenes</li>
                <li>✔ Contacto directo</li>
                <li>✔ Estadísticas básicas</li>
            </ul>

            <button class="btn btn-light w-100 fw-semibold">
                Contratar
            </button>
        </div>

        <!-- Profesional -->
        <div style="
            width:320px;
            border-radius:22px;
            padding:30px;
            background:#ffffff;
            box-shadow:0 10px 25px rgba(0,0,0,0.08);
            text-align:center;
        ">
            <h3 style="font-size:24px; font-weight:800;">Profesional</h3>
            <p style="font-size:32px; font-weight:900; margin:20px 0;">
                $999 / mes
            </p>
            <p style="color:#666; margin-bottom:20px;">
                Máxima visibilidad
            </p>

            <ul style="list-style:none; padding:0; margin:0 0 25px 0;">
                <li>✔ Perfil premium</li>
                <li>✔ Prioridad en resultados</li>
                <li>✔ Leads ilimitados</li>
                <li>✔ Estadísticas avanzadas</li>
                <li>✔ Soporte preferencial</li>
            </ul>

            <button class="btn btn-outline-primary w-100">
                Contratar
            </button>
        </div>

    </div>
    <!-- footer beneficios -->
    <div style="text-align:center; margin-bottom:50px; max-width:900px; margin-left:auto; margin-right:auto;">
        <h1 style="font-size:36px; font-weight:800; margin-bottom:10px;">
            Beneficios de nuestros planes
        </h1>

        <p style="font-size:18px; color:#666; margin-bottom:30px;">
            Impulsa tu negocio con mayor visibilidad, más clientes y herramientas diseñadas para ayudarte a crecer.
        </p>

        <div style="
        display:flex;
        justify-content:center;
        gap:30px;
        flex-wrap:wrap;
    ">

            <div style="max-width:260px;">
                <h3 style="font-size:20px; font-weight:700;">🚀 Más visibilidad</h3>
                <p style="color:#666;">
                    Aparece frente a más clientes potenciales y destaca tu negocio dentro de la plataforma.
                </p>
            </div>

            <div style="max-width:260px;">
                <h3 style="font-size:20px; font-weight:700;">📈 Crecimiento real</h3>
                <p style="color:#666;">
                    Genera más contactos y oportunidades con herramientas pensadas para convertir visitas en clientes.
                </p>
            </div>

            <div style="max-width:260px;">
                <h3 style="font-size:20px; font-weight:700;">🤝 Confianza y soporte</h3>
                <p style="color:#666;">
                    Brinda una imagen profesional y recibe soporte para aprovechar al máximo tu plan.
                </p>
            </div>

        </div>
    </div>


</div>

@code {

}
