@page "/search"

<div class="container-fluid my-4">
    <div class="row">

        <!-- FILTROS -->
        <aside class="col-12 col-lg-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h5 class="fw-bold mb-3">Filtrar resultados</h5>

                    <!-- Categoría -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Categoría</label>
                        <select class="form-select"
                                value="@SelectedCategoria"
                                @onchange="OnCategoriaChange">
                            <option value="">Todas</option>
                            @foreach (var categoria in Categorias)
                            {
                                <option value="@categoria.Nombre">
                                    @categoria.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Tags -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Servicios</label>

                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tag in Tags)
                            {
                                var isSelected = SelectedTags.Contains(tag.Nombre);

                                <span @onclick="() => ToggleFiltroTag(tag.Nombre)"
                                      class="badge @(isSelected ? "bg-primary text-white" : "bg-light text-dark border")"
                                      style="cursor:pointer;">
                                    @tag.Nombre
                                </span>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </aside>

        <!-- RESULTADOS -->
        <section class="col-12 col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">
                    Proveedores encontrados
                </h4>
            </div>

            <div class="row g-4">
                @foreach (var proveedor in Proveedors)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm">
                            <img src="@(proveedor.Galeria?.FirstOrDefault()?.Url ?? "/imagenes/default.jpg")"
                                 class="card-img-top"
                                 alt="Proveedor">

                            <div class="card-body">
                                <h5 class="card-title fw-bold">
                                    @proveedor.Nombre
                                </h5>

                                <p class="card-text text-muted small mb-2">
                                    @proveedor.Descripcion
                                </p>

                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success">
                                        ★ @proveedor.Resenas.Average(c => c.Calificacion).ToString("0.0")
                                    </span>

                                    <a href="javascript:void(0);"
                                       class="btn btn-outline-primary btn-sm"
                                       @onclick="() => IrAProveedor(proveedor.Stand)">
                                        Ver perfil
                                    </a>

                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <!-- PAGINACIÓN -->
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled">
                        <span class="page-link">Anterior</span>
                    </li>
                    <li class="page-item active">
                        <span class="page-link">1</span>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">2</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">Siguiente</a>
                    </li>
                </ul>
            </nav>

        </section>

    </div>
</div>
