@using Eventos360.Shared.DTOs
@inherits LayoutComponentBase

<div style="width:100%; padding:50px 0;">

    <!-- Card de Categoría -->
    <div style="
        width:100%;
        height:260px;
        border-radius:22px;
        background-image:url('@CategoriaImagenUrl');
        background-size:cover;
        background-position:center;
        position:relative;
        overflow:hidden;
        margin-bottom:40px;
    ">

        <!-- Overlay -->
        <div style="
            position:absolute;
            inset:0;
            background:linear-gradient(
                to right,
                rgba(0,0,0,0.75),
                rgba(0,0,0,0.3)
            );
        "></div>

        <!-- Contenido -->
        <div style="
            position:absolute;
            bottom:30px;
            left:30px;
            color:white;
            z-index:2;
            max-width:600px;
        ">
            <h1 style="font-size:34px; font-weight:800; margin:0;">
                @CategoriaNombre
            </h1>
            <p style="margin-top:10px; font-size:16px; line-height:1.5;">
                @CategoriaDescripcion
            </p>
        </div>
    </div>

    <!-- Carrusel -->
    <div style="display:flex; align-items:center; gap:20px;">

        <!-- Prev -->
        <button @onclick="Prev"
                style="width:45px;height:45px;border-radius:50%;
                       border:none;background:#f2f2f2;
                       font-size:20px;cursor:pointer;">
            ‹
        </button>

        <!-- Proveedores -->
        <div style="
            display:flex;
            gap:20px;
            flex:1;
            overflow:hidden;
        "
             @ontouchstart="OnTouchStart"
             @ontouchend="OnTouchEnd">

            @foreach (var proveedor in VisibleProveedores)
            {
                <div style="
                    min-width:240px;
                    height:260px;
                    border-radius:18px;
                    background-image:url('@proveedor.ImagenUrl');
                    background-size:cover;
                    background-position:center;
                    position:relative;
                    color:white;
                    overflow:hidden;
                    ">

                    <div style="
                        position:absolute;
                        inset:0;
                        background:linear-gradient(
                            to top,
                            rgba(0,0,0,0.75),
                            rgba(0,0,0,0.2)
                        );
                        "></div>

                    <div style="
                        position:absolute;
                        bottom:20px;
                        left:20px;
                        z-index:2;
                        ">
                        <h3 style="margin:0; font-size:18px; font-weight:700;">
                            @proveedor.Nombre
                        </h3>
                        <p style="margin:4px 0 0; font-size:13px;">
                            @proveedor.Ciudad
                        </p>
                    </div>

                </div>
            }

        </div>

        <!-- Next -->
        <button @onclick="Next"
                style="width:45px;height:45px;border-radius:50%;
                       border:none;background:#f2f2f2;
                       font-size:20px;cursor:pointer;">
            ›
        </button>

    </div>

</div>
