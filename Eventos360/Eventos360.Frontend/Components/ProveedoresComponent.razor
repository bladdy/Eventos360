@using Eventos360.Shared.DTOs
@inherits LayoutComponentBase

<div style="width:100%; padding:40px 5px; box-sizing:border-box; overflow:hidden;">

    <!-- Header -->
    <div class="responsive-header" style="
    position:relative;
    width:100%;
    height:300px;
    margin-bottom:40px;
">

        <!-- Imagen derecha -->
        <div class="responsive-hide-image" style="
            position:absolute;
            top:0;
            right:0;
            width:70%;
            height:100%;
            background-image:url('@CategoriaImagenUrl');
            background-size:cover;
            background-position:center;
            border-radius:22px;
            overflow:hidden;
        ">

            </div>

        <!-- Card frontal -->
        <div class="responsive-card" style="
            position:absolute;
            left:5px;
            top:50%;
            transform:translateY(-50%);
            width:35%;
            height:80%;
            background:white;
            padding:30px;
            border-radius:22px;
            z-index:2;
            box-shadow:3px 3px 3px 3px rgba(0,0,0,0.25);

            display:flex;
            flex-direction:column;
            justify-content:center;
            align-items:start;
            text-align:start;
        ">
                    <h1 style="
                margin:0 0 16px 0;
                font-size:32px;
                font-weight:800;
            ">
                        @CategoriaNombre
                    </h1>

                    <p style="
                margin:0 0 20px 0;
                font-size:16px;
                color:#555;
                max-width:90%;
            ">
                        @CategoriaDescripcion
                    </p>

            <a href="javascript:void(0);" @onclick="() => IrABusqueda(CategoriaNombre)"
                       class="btn btn-outline-primary">
                        Ver más @CategoriaNombre
                    </a>
                </div>


    </div>


 <!-- Carrusel -->
    <div style="
        display:flex;
        align-items:center;
        gap:20px;
        width:100%;
        max-width:100%;
        box-sizing:border-box;
    ">

        <!-- Prev -->
        <button @onclick="Prev"
                style="width:45px;height:45px;border-radius:50%;
                       border:none;background:#f2f2f2;font-size:20px; flex-shrink:0;">
            ‹
        </button>

        <!-- VIEWPORT REAL -->
        <div @ref="CarouselProveeRef"
             style="
                position:relative;
                overflow:hidden;
                flex:1;
                max-width:100%;
                box-sizing:border-box;
                touch-action:pan-y;
             ">

            <!-- TRACK (NO AFECTA LAYOUT) -->
            <div 
                 style="
                display:flex;
                gap:@($"{Gap}px");
                transform:translateX(@TranslateX);
                transition:transform 0.4s ease;
                will-change:transform;
            "
                 @ontouchstart="OnTouchStart"
                 @ontouchend="OnTouchEnd">

                @foreach (var proveedor in VisiblesProveedores)
                {
                    var promedio = (proveedor.Resenas != null && proveedor.Resenas.Any())
                    ? proveedor.Resenas.Average(c => c.Calificacion)
                    : 0;

                    var productoDestacado = proveedor.Productos?
                    .FirstOrDefault(x => x.Destacado);

                    <div class="card" style="width:20rem;">
                        <img src="@(proveedor.Galeria?.FirstOrDefault()?.Url ?? "/imagenes/default.jpg")"
                             class="card-img-top"
                             alt="@proveedor.Nombre">

                        <div class="card-body">
                            <h5 class="card-title">
                                @proveedor.Nombre
                                <span class="badge bg-success">
                                    ★ @promedio.ToString("0.0")
                                </span>
                            </h5>

                            <p class="card-text">
                                @proveedor.Ciudad
                            </p>

                            <p class="card-text">
                                @(productoDestacado != null
                                    ? $"Desde {productoDestacado.Precio:C0}"
                                    : "Consultar precio")
                            </p>

                            <div class="d-flex justify-content-between align-items-center">
                                <a href="javascript:void(0);"
                                   class="btn btn-outline-primary btn-sm"
                                   @onclick="() => IrAProveedor(proveedor.Stand)">
                                    Ver perfil
                                </a>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>

        <!-- Next -->
        <button @onclick="Next"
                style="width:45px;height:45px;border-radius:50%;
                       border:none;background:#f2f2f2;font-size:20px; flex-shrink:0;">
            ›
        </button>

    </div>
</div>
