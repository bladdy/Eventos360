﻿@using Eventos360.Shared.DTOs
@using System.Collections.Generic
@inherits LayoutComponentBase

<div style="width:100%; padding:40px 0;">

    <h1 style="font-size:32px; font-weight:700; margin-bottom:30px;">
        Explora profesionales de eventos por categoría
    </h1>

    <div style="display:flex; align-items:center; gap:20px;">

        <!-- Botón anterior -->
        <button @onclick="Prev"
                style="width:45px;height:45px;border-radius:50%;
                       border:none;background:#f2f2f2;font-size:20px;">
            ‹
        </button>

        <!-- Viewport -->
        <div @ref="CarouselRef"
             style="overflow:hidden; flex:1; touch-action:pan-y;">

            <!-- Track -->
            <div style="
                display:flex;
                gap:20px;
                transform:translateX(@TranslateX);
                transition:transform 0.4s ease;
            "
                 @ontouchstart="OnTouchStart"
                 @ontouchend="OnTouchEnd">

                @foreach (var categoria in VisibleCategories)
                {
                    <div @onclick="() => IrABusqueda(categoria)"
                         style="
                        min-width:@($"{CardWidth}px");
                        height:260px;
                        border-radius:18px;
                        background-image:url('@categoria.ImagenUrl');
                        background-size:cover;
                        background-position:center;
                        position:relative;
                        color:white;
                        flex-shrink:0;
                        overflow:hidden;
                        cursor:pointer;
                            ">

                        <div style="
                            position:absolute;
                            inset:0;
                            background:linear-gradient(
                                to top,
                                rgba(0,0,0,0.7),
                                rgba(0,0,0,0.2));
                                "></div>

                        <div style="
                            position:absolute;
                            bottom:20px;
                            left:20px;
                            z-index:2;
                                ">
                            <h2 style="margin:0;font-size:20px;font-weight:700;">
                                @categoria.Nombre
                            </h2>
                            <p style="margin:4px 0 0;font-size:14px;">
                                @categoria.Proveedores.Count Proveedores
                            </p>
                        </div>
                    </div>
                }

            </div>
        </div>

        <!-- Botón siguiente -->
        <button @onclick="Next"
                style="width:45px;height:45px;border-radius:50%;
                       border:none;background:#f2f2f2;font-size:20px;">
            ›
        </button>

    </div>
</div>